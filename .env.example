# Copy to .env (never commit .env)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
API_URL=http://localhost:8000

# Optional: Slack incoming-webhook URL for the 80%-of-life alert (leave unset for dry-run).
# The dashboard reads it from the shell environment, not from this file: export SLACK_WEBHOOK_URL=... before `streamlit run`.
SLACK_WEBHOOK_URL=
